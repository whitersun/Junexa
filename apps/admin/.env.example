# Leave DATABASE_URL empty for a single-process local file demo.
DATABASE_URL=
# Required in production. Enter this token in the admin app's Settings.
ADMIN_TOKEN=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=junexa-menu
R2_PUBLIC_URL=
# Optional absolute path; default is the repository's existing .data/store.json.
STORE_FILE=
