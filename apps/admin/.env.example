# Leave DATABASE_URL empty for a single-process local file demo.
DATABASE_URL=
# Required in production. Enter this token in the admin app's Settings.
ADMIN_TOKEN=
# Server-only Neon Object Storage configuration.
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=junexa-menu
# Storage endpoint followed by /junexa-menu; bucket must allow public reads.
STORAGE_PUBLIC_URL=
# Optional absolute path; default is the repository's existing .data/store.json.
STORE_FILE=
